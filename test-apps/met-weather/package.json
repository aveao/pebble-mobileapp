{
  "name": "met-weather",
  "author": "Pebble",
  "version": "1.0.3",
  "pebble": {
    "displayName": "MET Norway Weather",
    "uuid": "323dc117-55bd-455f-9ee4-4d0faba56ea1",
    "sdkVersion": "3",
    "usesPermissions": [
      "Location",
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.met.no"
          ]
        }
      }
    ],
    "plugin": {
      "description": "Weather for the user's weather locations (the phone's position for the current-location one), from the Norwegian Meteorological Institute (api.met.no), in their units. One instance per location, keyed like the built-in weather plugin's, and the hours ahead of each.",
      "script": "plugin.js",
      "sources": [
        {
          "category": "weather",
          "items": [
            "location"
          ],
          "properties": {
            "name": [
              "shortText"
            ],
            "temperature": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "feels_like": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "high": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "low": [
              "shortText",
              "longText",
              "numericValue"
            ],
            "condition": [
              "shortText",
              "longText",
              "icon",
              "image"
            ],
            "condition_code": [
              "longText"
            ],
            "uv_index": [
              "numericValue",
              "shortText"
            ],
            "hourly_temperature": [
              "series.numericValue",
              "series.shortText"
            ],
            "hourly_condition": [
              "series.shortText",
              "series.icon",
              "series.image"
            ],
            "hourly_condition_code": [
              "series.longText"
            ]
          },
          "callerPermissions": [
            "Location"
          ],
          "suggestedRefreshIntervalSec": 1800
        }
      ]
    }
  }
}
